<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f3f0e8">
  <title><%= heading %> — Ink &amp; Ivory</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Ink and Ivory home">
      <span class="brand-mark">I</span>
      <span>Ink &amp; Ivory</span>
    </a>
    <nav class="header-actions" aria-label="Primary navigation">
      <a class="nav-link" href="/">Stories</a>
      <a class="nav-link active" href="/new">Write</a>
    </nav>
  </header>

  <main class="editor-shell">
    <a class="back-link" href="/">← Back to stories</a>

    <div class="editor-heading">
      <p class="eyebrow"><%= locals.post ? "Editing story" : "New story" %></p>
      <h1><%= heading %></h1>
      <p>Give your idea a clear title and a memorable voice.</p>
    </div>

    <% if (locals.post) { %>
      <form class="editor-form" id="editForm" method="post" action="/api/posts/<%= post.id %>">
        <div class="field">
          <label for="title">Title</label>
          <input id="title" type="text" name="title" value="<%= post.title %>" required maxlength="120">
        </div>
        <div class="field">
          <label for="content">Story</label>
          <textarea id="content" name="content" rows="12" required><%= post.content %></textarea>
        </div>
        <div class="field field-author">
          <label for="author">Author</label>
          <input id="author" type="text" name="author" value="<%= post.author %>" required maxlength="60">
        </div>
        <div class="form-actions">
          <a class="button button-secondary" href="/">Cancel</a>
          <button class="button button-primary" type="submit"><%= submit %></button>
        </div>
      </form>
    <% } else { %>
      <form class="editor-form" id="newPostForm" method="post" action="/api/posts">
        <div class="field">
          <label for="title">Title</label>
          <input id="title" type="text" name="title" placeholder="What is your story about?" required maxlength="120" autofocus>
        </div>
        <div class="field">
          <label for="content">Story</label>
          <textarea id="content" name="content" placeholder="Begin writing..." required rows="12"></textarea>
        </div>
        <div class="field field-author">
          <label for="author">Author</label>
          <input id="author" type="text" name="author" placeholder="Your name" required maxlength="60">
        </div>
        <div class="form-actions">
          <a class="button button-secondary" href="/">Cancel</a>
          <button class="button button-primary" type="submit"><%= submit %></button>
        </div>
      </form>
    <% } %>
  </main>
</body>
</html>
